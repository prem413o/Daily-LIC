import java.util.*;
class Solution {
    public static int maxProduct(int[] nums) {
       int max=-10;
       for(int i=0;i<nums.length;i++){
        int pro=1;
        for(int j=i;j<nums.length;j++){
            pro*=nums[j];
            max=Math.max(max,pro);

        }
       }
       return max;
    }
    public static void main(String args[]){
        int nums[]={-2};
        System.out.println(maxProduct(nums));
    }
}
